# Copy to .env.local

# Optional. Dashboard works from live Sleeper data without a database.
# Neon’s Vercel integration may set DATABASE_URL_UNPOOLED instead.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/db?sslmode=require"
# DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@HOST/db?sslmode=require"

# Admin login password. ADMIN_PASSWORD is preferred; ADMIN_PIN still works.
ADMIN_PASSWORD="change-me"
# ADMIN_PIN="change-me"
SLEEPER_SEASON="2026"

# Vercel sets CRON_SECRET for scheduled jobs.
# CRON_SECRET=""

# Unofficial Sleeper GraphQL JWT. Never commit. Chat post stays off until
# commissioner approval AND SLEEPER_CHAT_POST=1.
# SLEEPER_TOKEN=""
# SLEEPER_CHAT_POST=""
